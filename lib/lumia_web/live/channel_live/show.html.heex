<ul role="list" class="divide-y divide-gray-800 bg-gray-900 mb-16" phx-update="stream" id="messages" phx-viewport-top="load-previous">
  <li :for={{dom_id, message} <- @streams.messages} class="py-5 px-5" id={dom_id}>
    <div class="flex justify-between gap-x-6">
      <div class="flex grow gap-x-4">
        <img
          class="h-12 w-12 flex-none rounded-full bg-gray-800"
          src={avatar_url(message.user.email)}
          alt={"#{message.user.email}'s avatar"}
        />
        <div class="min-w-0 flex-auto">
          <p class="text-sm font-semibold leading-6 text-white">
            <%= message.user.email %>
          </p>
          <div class="mt-1 leading-5 text-gray-300">
            <div id={"message-text-#{message.id}"} phx-hook="Highlight" phx-update="ignore" class="message-body">
              <%= raw Earmark.as_html!(message.text,
                breaks: true,
                code_class_prefix: "",
                escape: false
              ) %>
            </div>
          </div>
        </div>
      </div>
      <div class="hidden sm:flex sm:flex-col sm:items-end">
        <p class="mt-1 text-xs leading-5 text-gray-400">
          <time datetime={iso_time(message.inserted_at)}>
            <%= relative_time(message.inserted_at) %>
          </time>
        </p>
      </div>
    </div>
  </li>
</ul>
<!-- New comment form -->

<div class="mt-0 fixed bottom-0 left-72 right-0 gap-x-3 bg-gray-900">
  <.simple_form
    for={@message_form}
    id="message-form"
    class="relative flex-auto !space-y-0 !mt-0"
    phx-change="validate-message"
    phx-submit="add-message"
  >
  <div class="flex grow bg-gray-800 rounded-lg align-middle items-center px-4 py-3">
    <div class="flex shrink text-gray-400">
      <svg class="h-5 w-5 fill-gray-400" xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><!--! Font Awesome Free 6.4.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM232 344V280H168c-13.3 0-24-10.7-24-24s10.7-24 24-24h64V168c0-13.3 10.7-24 24-24s24 10.7 24 24v64h64c13.3 0 24 10.7 24 24s-10.7 24-24 24H280v64c0 13.3-10.7 24-24 24s-24-10.7-24-24z"/></svg>
    </div>
    <div class="grow">
      <.input
        field={@message_form[:text]}
        type="message"
        maxlength="600"
        placeholder={"Message ##{@channel.name}"}
        phx-hook="EnterSubmit"
        class={[
          "block h-8 w-full mt-0 rounded-lg focus:ring-0 sm:text-sm",
          "phx-no-feedback:border-zinc-300 phx-no-feedback:focus:border-zinc-400",
          "bg-transparent resize-none border-0 py-1.5 placeholder:text-gray-400 focus:ring-0 sm:text-sm text-gray-200"
        ]}
      />
    </div>
    <div class="shrink">
    <.button
      type="submit"
      phx-disable-with="Posting..."
      class="rounded-md bg-white px-2.5 py-1 text-sm font-semibold text-gray-800 bg-gray-400 shadow-sm hover:bg-gray-50"
    >
      Send
    </.button>
    </div>
  </div>
  </.simple_form>
</div>

<.back navigate={~p"/channels"}>Back to channels</.back>

<.modal :if={@live_action == :edit} id="channel-modal" show on_cancel={JS.patch(~p"/channels/#{@channel}")}>
  <.live_component
    module={LumiaWeb.ChannelLive.FormComponent}
    id={@channel.id}
    title={@page_title}
    action={@live_action}
    channel={@channel}
    patch={~p"/channels/#{@channel}"}
  />
</.modal>
