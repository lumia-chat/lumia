{
  "name": "lumia-web",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "tokens": "bun run scripts/tokens.ts",
    "wasm": "bun run scripts/wasm.ts",
    "dev": "bun run tokens && vite",
    "build": "bun run tokens && bun run wasm && tsc --noEmit && vite build",
    "check": "bun run tokens && bun run wasm && tsc --noEmit",
    "test": "bun test src",
    "preview": "vite preview",
    "e2e": "bun run e2e/run.ts",
    "build:instance": "bun run tokens && bun run wasm && tsc --noEmit && vite build --mode instance --outDir ../instance/priv/static/ui --emptyOutDir"
  },
  "dependencies": {
    "@tanstack/solid-query": "^5.105.2",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-virtual": "^3.13.52",
    "emojibase-data": "17.0.0",
    "solid-js": "1.9.9"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "bun-types": "^1.4.4",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
