#!/bin/sh
# Operator commands (docs/specs/deployment.md): run inside the release.
#   bin/lumia-admin migrate
#   bin/lumia-admin backup <dir>
#   bin/lumia-admin restore <dir> [--replace] [--allow-missing-blobs]
set -eu
here=$(dirname "$0")
case "${1:-}" in
  migrate) exec "$here/lumia" eval "Lumia.Release.migrate()" ;;
  backup)  exec "$here/lumia" eval "Lumia.Release.backup(\"$2\")" ;;
  restore)
    dir=$2; shift 2
    replace=false; missing=false
    for flag in "$@"; do
      case "$flag" in
        --replace) replace=true ;;
        --allow-missing-blobs) missing=true ;;
        *) echo "lumia-admin restore: unknown option $flag" >&2; exit 64 ;;
      esac
    done
    exec "$here/lumia" eval "Lumia.Release.restore(\"$dir\", replace: $replace, allow_missing_blobs: $missing) |> IO.inspect()" ;;
  *) echo "usage: lumia-admin migrate | backup <dir> | restore <dir> [--replace] [--allow-missing-blobs]" >&2; exit 64 ;;
esac
