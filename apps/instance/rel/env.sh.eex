#!/bin/sh
# Distribution for the multi-node profile (docs/specs/deployment.md 2.2):
# DNS gives the other nodes' addresses, so a node is named by its own
# address and uses long names. A single node runs the same way.
#
# Fly's private network is IPv6 only and names the machine's address in
# FLY_PRIVATE_IP; an IPv6 address needs the inet6 distribution carrier.
addr="${FLY_PRIVATE_IP:-$(hostname -i | cut -d' ' -f1)}"
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="lumia@${addr}"
case "$addr" in
  *:*) export ERL_AFLAGS="-proto_dist inet6_tcp ${ERL_AFLAGS:-}" ;;
esac
