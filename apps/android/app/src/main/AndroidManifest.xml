<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".LumiaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Lumia"
        android:usesCleartextTraffic="true">
        <!-- One task: a notification's tap reaches the running activity through onNewIntent.
             The phone going dark or light is the activity's own to take (uiMode): the
             colours are drawn from it as it changes, and the screen a person is on stays.
             Any other change (the phone turned) makes the activity again, over the same
             store and session, which are the application's (LumiaApp). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The browser's way back: a sign-in through the instance's web
                 page or its OIDC provider returns on lumia://sign-in with a
                 one-time token (architecture 6.3). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumia" />
            </intent-filter>
        </activity>
        <!-- Push (architecture 15.5): the UnifiedPush distributor's events, and FCM's. -->
        <service
            android:name=".push.LumiaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".push.LumiaFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
