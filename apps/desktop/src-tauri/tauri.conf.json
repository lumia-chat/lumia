{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumia",
  "version": "0.2.1",
  "identifier": "chat.lumia.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumia",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/lumia-chat/lumia/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMjhGMTFGMUFCRDA4ODcKUldTSENMMGFIL0VvWERYVFAxZWJpUTRITXVQY090ak1ZYzNGeDQ1b1Rkdi92L3lHY3djcWQxV2UK"
    }
  }
}
