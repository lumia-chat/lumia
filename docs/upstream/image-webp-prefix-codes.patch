+
+    /// A 4x4 black lossless image whose entropy image selects the last of `groups` prefix code
+    /// groups, each with a green code of 2048 symbols of length 11 (a 1024 entry table and a
+    /// 4096 node tree) that takes 66 bits to write.
+    fn lossless_with_groups(groups: u32) -> Vec<u8> {
+        struct Bits(Vec<u8>, u64, u32);
+        impl Bits {
+            fn put(&mut self, value: u32, bits: u32) {
+                self.1 |= u64::from(value) << self.2;
+                self.2 += bits;
+                while self.2 >= 8 {
+                    self.0.push(self.1 as u8);
+                    self.1 >>= 8;
+                    self.2 -= 8;
+                }
+            }
+            fn single(&mut self, symbol: u32) {
+                self.put(0b01, 2);
+                if symbol < 2 {
+                    self.put(0, 1);
+                    self.put(symbol, 1);
+                } else {
+                    self.put(1, 1);
+                    self.put(symbol, 8);
+                }
+            }
+        }
+        let mut b = Bits(vec![0x2f], 0, 0);
+        b.put(3, 14); // width - 1
+        b.put(3, 14); // height - 1
+        b.put(0, 4); // no alpha, version 0
+        b.put(0, 1); // no transforms
+        b.put(1, 1); // color cache
+        b.put(11, 4); // of 2048 entries
+        b.put(1, 1); // meta prefix codes
+        b.put(0, 3); // 4x4 blocks, so a 1x1 entropy image
+        b.put(0, 1); // the entropy image has no color cache
+        b.single((groups - 1) & 0xff); // green
+        b.single((groups - 1) >> 8); // red
+        for _ in 0..3 {
+            b.single(0); // blue, alpha, distance
+        }
+        for _ in 0..groups {
+            b.put(0, 1); // normal code
+            b.put(11, 4); // 15 code length code lengths
+            for i in 0..15 {
+                b.put(u32::from(i == 14), 3); // only the code length 11
+            }
+            b.put(1, 1); // max_symbol is given
+            b.put(5, 3); // in 12 bits
+            b.put(2046, 12); // 2048 symbols
+            for _ in 0..4 {
+                b.single(0);
+            }
+        }
+        b.put(0, 7);
+        // The pixels: 16 green codes of 11 zero bits, symbol 0.
+        b.0.extend_from_slice(&[0; 32]);
+        let vp8l = b.0;
+
+        let mut webp = b"RIFF".to_vec();
+        webp.extend_from_slice(&(vp8l.len() as u32 + 12).to_le_bytes());
+        webp.extend_from_slice(b"WEBPVP8L");
+        webp.extend_from_slice(&(vp8l.len() as u32).to_le_bytes());
+        webp.extend_from_slice(&vp8l);
+        webp
+    }
+
+    #[test]
+    fn lossless_prefix_codes_count_against_memory_limit() {
+        let decode = |groups: u32, limit: usize| {
+            let mut decoder =
+                WebPDecoder::new(std::io::Cursor::new(lossless_with_groups(groups))).unwrap();
+            decoder.set_memory_limit(limit);
+            let mut data = [0xff; 4 * 4 * RGB_BPP];
+            decoder.read_image(&mut data).map(|()| data)
+        };
+
+        // Two groups' codes fit in 256 KiB.
+        let data = decode(2, 256 << 10).unwrap();
+        assert!(data.iter().all(|&b| b == 0));
+
+        // 64 do not, and are refused before they are allocated.
+        assert!(matches!(
+            decode(64, 256 << 10),
+            Err(DecodingError::MemoryLimitExceeded)
+        ));
+        assert!(decode(64, usize::MAX).is_ok());
+    }
 }
