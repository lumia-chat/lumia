{
  "about": "Heights a post's embed reports by postMessage (docs/specs/media.md 6.6), as lumia_core::embeds::reported_height reads them: `message` is what the embed's window posted, as text (a string as posted, an object as its JSON). `expect` is the height drawn, rounded up and held to 50..=5000, or null for none.",
  "vectors": [
    {
      "provider": "x",
      "message": "twttr.embed{\"jsonrpc\":\"2.0\",\"method\":\"twttr.private.resize\",\"params\":[{\"height\":612.4,\"width\":550}],\"id\":\"1\"}",
      "expect": 613,
      "why": "X's string form: the JSON after the key; rounded up"
    },
    {
      "provider": "x",
      "message": "{\"twttr.embed\":{\"method\":\"twttr.private.resize\",\"params\":[{\"height\":612,\"width\":550}],\"id\":\"1\"}}",
      "expect": 612,
      "why": "X's object form, as its JSON"
    },
    {
      "provider": "x",
      "message": "{\"twttr.embed\": \"{\\\"method\\\": \\\"twttr.private.resize\\\", \\\"params\\\": [{\\\"height\\\": \\\"700\\\"}]}\"}",
      "expect": 700,
      "why": "X's object holding the JSON as text, the height as a string of digits"
    },
    {
      "provider": "x",
      "message": "{\"twttr.embed\":{\"method\":\"twttr.private.ready\",\"params\":[]}}",
      "expect": null,
      "why": "another of X's methods"
    },
    {
      "provider": "x",
      "message": "{\"height\":400}",
      "expect": null,
      "why": "a Bluesky-shaped message is not X's"
    },
    {
      "provider": "x",
      "message": "twttr.embed{not json",
      "expect": null,
      "why": "not JSON after the key"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":412,\"id\":\"abc\"}",
      "expect": 412,
      "why": "Bluesky's {height, id}"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":\"412.2\"}",
      "expect": 413,
      "why": "a height as a string of digits"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":\"412px\"}",
      "expect": null,
      "why": "not a number"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":-5}",
      "expect": null,
      "why": "not a height"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":0}",
      "expect": null,
      "why": "not a height"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":12}",
      "expect": 50,
      "why": "held to the shortest"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":4500}",
      "expect": 4500,
      "why": "a long post grows that far"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":90000}",
      "expect": 5000,
      "why": "held to the tallest rather than dropped"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":1e400}",
      "expect": null,
      "why": "not a finite number"
    },
    {
      "provider": "bluesky",
      "message": "[412]",
      "expect": null,
      "why": "not an object"
    },
    {
      "provider": "reddit",
      "message": "{\"type\":\"resize.embed\",\"data\":733}",
      "expect": 733,
      "why": "Reddit's resize.embed"
    },
    {
      "provider": "reddit",
      "message": "{\"type\":\"other\",\"data\":733}",
      "expect": null,
      "why": "another of Reddit's messages"
    },
    {
      "provider": "reddit",
      "message": "{\"height\":733}",
      "expect": null,
      "why": "not Reddit's form"
    },
    {
      "provider": "youtube",
      "message": "{\"height\":400}",
      "expect": null,
      "why": "a player does not grow"
    },
    {
      "provider": "facebook",
      "message": "{\"height\":400}",
      "expect": null,
      "why": "Facebook's posts are a fixed height"
    },
    {
      "provider": "bluesky",
      "message": "{\"height\":400,\"pad\":\"\"}",
      "expect": null,
      "why": "longer than any resize: not read"
    }
  ]
}
