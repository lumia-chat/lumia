      "page_url": "https://video.example/clip",
      "expect": {
        "url": "https://video.example/clip",
        "title": "A clip",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": true
      }
