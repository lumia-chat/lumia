        "color": "",
        "image_url": "https://cdn.example.net/assets/pic.jpg",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "unquoted",
      "note": "unquoted attributes, either attribute order, keys in any case, a scheme-relative image; url is the page_url as given",
