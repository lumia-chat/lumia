        "site_name": "",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "bad-values",
      "note": "the first valid theme-color; an image that is not http(s) is dropped, Open Graph's and Twitter's alike",
