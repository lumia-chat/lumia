        "url": "https://example.com/head-only",
        "title": "Only the head",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "comments-and-scripts",
      "note": "comments, scripts and styles hold no tags; single-quoted attributes",
