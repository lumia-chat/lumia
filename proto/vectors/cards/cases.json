{
  "vectors": [
    {
      "name": "og-full",
      "note": "Open Graph first; whitespace collapsed; relative image resolved; #rgb widened and lowercased",
      "file": "pages/og-full.html",
      "page_url": "https://example.com/articles/one?ref=x",
      "expect": {
        "url": "https://example.com/articles/one?ref=x",
        "title": "The first article",
        "description": "What happened, and why.",
        "site_name": "Example News",
        "color": "#aabbcc",
        "image_url": "https://example.com/images/one.jpg",
        "image_width": 1200,
        "image_height": 630,
        "video": false
      }
    },
    {
      "name": "og-image-structure",
      "note": "secure_url preferred when https; og:image:* after a second og:image describe that one, not the first",
      "file": "pages/og-image-structure.html",
      "page_url": "http://example.org/post",
      "expect": {
        "url": "http://example.org/post",
        "title": "Secure picture",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "https://cdn.example.org/a.png",
        "image_width": 800,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "og-secure-url-not-https",
      "note": "an og:image:secure_url that is not https is ignored",
      "file": "pages/og-secure-url-not-https.html",
      "page_url": "https://example.net/",
      "expect": {
        "url": "https://example.net/",
        "title": "Not so secure",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "https://example.net/a.png",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "twitter-fallback",
      "note": "no Open Graph: Twitter's tags, by property= or name=, before <title> and description",
      "file": "pages/twitter-fallback.html",
      "page_url": "https://social.example/status/1",
      "expect": {
        "url": "https://social.example/status/1",
        "title": "Twitter title",
        "description": "Twitter description",
        "site_name": "",
        "color": "",
        "image_url": "https://img.social.example/1.jpg",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "title-fallback",
      "note": "no Open Graph or Twitter: <title> and <meta name=description>, any case, entities decoded",
      "file": "pages/title-fallback.html",
      "page_url": "https://plain.example/",
      "expect": {
        "url": "https://plain.example/",
        "title": "Fish & Chips — a history",
        "description": "Everything about \"fish\" and chips.",
        "site_name": "",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "no-title",
      "note": "a page with no title (a blank one is none) has no card",
      "file": "pages/no-title.html",
      "page_url": "https://example.com/untitled",
      "expect": null
    },
    {
      "name": "entities",
      "note": "named and numeric references; &nbsp; is whitespace and collapses; an unknown name stays; &#150; is Windows-1252's en dash",
      "file": "pages/entities.html",
      "page_url": "https://example.com/e",
      "expect": {
        "url": "https://example.com/e",
        "title": "Tom & Jerry's 😀 café time &unknown; – <b>",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "long",
      "note": "title at most 300 characters and description at most 1000, the last an ellipsis, trailing space trimmed before it",
      "file": "pages/long.html",
      "page_url": "https://example.com/long",
      "expect": {
        "url": "https://example.com/long",
        "title": "word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word…",
        "description": "…",
        "site_name": "Long",
        "color": "",
        "image_url": "",
        "image_width": 0,
        "image_height": 0,
        "video": false
      }
    },
    {
      "name": "video-type",
      "note": "og:type video.* marks a video",
      "file": "pages/video-type.html",
      "page_url": "https://video.example/watch?v=1",
      "expect": {
        "url": "https://video.example/watch?v=1",
        "title": "A video",
        "description": "",
        "site_name": "",
        "color": "",
        "image_url": "https://video.example/thumb.jpg",
        "image_width": 0,
        "image_height": 0,
        "video": true
      }
    },
    {
      "name": "video-tag",
